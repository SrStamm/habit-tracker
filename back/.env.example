# Copy to .env and fill in real values. .env is gitignored.

# MongoDB connection string.
MONGO_URI=

# Secret used to sign auth tokens.
JWT_SECRET=

# API port.
PORT=3000

# IANA time zone that defines the calendar day for every entry.
# The server derives each entry's day key ("YYYY-MM-DD") from the request
# instant using this zone, and it is the same zone used to resolve the
# from/to bounds of the entries query. The boot fails if this is missing or
# invalid, rather than falling back to the host's zone.
# Valid values include "America/Argentina/Buenos_Aires" and "Europe/Madrid".
APP_TIMEZONE=America/Argentina/Buenos_Aires
